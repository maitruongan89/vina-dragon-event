{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/page", "destination": "/admin.html" },
    { "source": "/api/sync", "destination": "/api/sync.js" },
    { "source": "/api/rpc", "destination": "/api/rpc.js" }
  ],
  "headers": [
    {
      "source": "/bgm.mp3",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Content-Type", "value": "audio/mpeg" }
      ]
    }
  ]
}
